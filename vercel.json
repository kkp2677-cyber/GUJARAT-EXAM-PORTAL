{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**,public/**,index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/api/index.ts"
    },
    {
      "source": "/sitemap",
      "destination": "/api/index.ts"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}

